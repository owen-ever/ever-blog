# docker-compose.nas.yaml에서 쓰는 값입니다.
# NAS의 Container Manager 프로젝트 폴더에 .env로 복사한 뒤 고칩니다.
# 비밀 값(레지스트리 비밀번호 등)은 이 파일에 넣지 않습니다. 레지스트리 로그인은 NAS에서 따로 합니다.

# NAS 레지스트리의 이미지 이름입니다.
EVER_BLOG_IMAGE=docker.owen.kr/ever-blog
# 실행할 이미지 태그입니다. 이미 push한 버전만 씁니다.
EVER_BLOG_TAG=0.2.2
# NAS에서 여는 포트입니다. 컨테이너 안쪽 포트는 3000으로 고정입니다.
EVER_BLOG_PORT=3000
# 포스트(마크다운) 폴더입니다. 상대 경로는 프로젝트 폴더 기준입니다.
EVER_BLOG_POSTS_DIR=./posts
# 포스트 이미지 폴더입니다. 컨테이너 안의 /posts/images로 연결합니다.
EVER_BLOG_IMAGES_DIR=./images
